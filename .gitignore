# Secrets — NEVER commit
.env
*.key

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local model caches / vector stores — ignore everything in .cache EXCEPT the small
# BM25 corpus JSONL, which retrieval needs at runtime (so the deployed app works).
.cache/*
!.cache/corpus/
.cache/corpus/*
!.cache/corpus/*.jsonl
faiss_index*/
*.log

# Editor / tooling local settings
.claude/settings.local.json
.vscode/
.idea/

# OS
.DS_Store

# CI workflow — add after granting gh the "workflow" scope: git add -f .github/workflows/ci.yml
.github/workflows/ci.yml
