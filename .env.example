# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- required ---
NEBIUS_API_KEY=          # embeddings + open-model generation (Nebius Token Factory)
PINECONE_API_KEY=        # serverless vector store

# --- optional ---
OPENAI_API_KEY=          # adds GPT-4o / GPT-4o-mini to the answer-model dropdown
# ANTHROPIC_API_KEY=     # reserved for Claude answer models (not wired by default)

# --- optional overrides ---
# SEC_USER_AGENT=        # EDGAR requires a descriptive UA with a contact email
